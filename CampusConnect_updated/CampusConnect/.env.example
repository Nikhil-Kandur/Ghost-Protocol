# AI provider. Use Sarvam AI ("sarvam") or disable live LLM review ("deterministic").
AI_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v2

# Optional OpenAI-compatible fallback. Keep keys server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Public GitHub API. Optional; a token improves the API rate limit.
GITHUB_TOKEN=

# Local persistence and demo settings. For real deployment, disable demo accounts.
CAMPUS_DB_PATH=./data/campus_connect.sqlite3
CAMPUS_DEMO_MODE=true
CAMPUS_SEED_DEMO=true
CAMPUS_SESSION_DAYS=7
CAMPUS_COOKIE_SECURE=false

# On first production startup, these create/promote the initial administrator.
# Use a unique password with at least 12 characters; do not commit real values.
CAMPUS_ADMIN_EMAIL=
CAMPUS_ADMIN_PASSWORD=
CAMPUS_ADMIN_NAME=Campus Connect Admin

# Optional SMTP for the "in-app inbox + email" preference.
CAMPUS_SMTP_HOST=
CAMPUS_SMTP_PORT=587
CAMPUS_SMTP_USERNAME=
CAMPUS_SMTP_PASSWORD=
CAMPUS_SMTP_FROM=
CAMPUS_SMTP_STARTTLS=true
CAMPUS_SMTP_TIMEOUT=4
